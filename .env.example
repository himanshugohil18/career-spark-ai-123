# ---------------------------------------------------------------------------
# CareerOS — environment template
# Copy to `.env` and fill in your own values. NEVER commit the real `.env`.
# ---------------------------------------------------------------------------

# --- Backend (Supabase / Lovable Cloud) -------------------------------------
# Client-side (safe to expose — publishable key only)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key_here
VITE_SUPABASE_PROJECT_ID=your_project_ref_here

# Server-side mirrors of the same values (used by server functions / SSR)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key_here
SUPABASE_PROJECT_ID=your_project_ref_here

# Privileged key — server only, bypasses row level security. Never expose.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# --- AI (Lovable AI Gateway) ------------------------------------------------
LOVABLE_API_KEY=your_lovable_ai_gateway_key_here

# --- App ------------------------------------------------------------------
APP_URL=http://localhost:8080

# --- Transactional email (Resend) ------------------------------------------
RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM_EMAIL=noreply@yourdomain.com
RESEND_FROM_NAME=CareerOS
RESEND_REPLY_TO=support@yourdomain.com
INVOICE_FROM_EMAIL=billing@yourdomain.com
LOVABLE_SEND_URL=your_managed_email_send_url_here

# --- Payments (Razorpay) ----------------------------------------------------
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# --- Scheduled jobs (cron endpoint authentication) -------------------------
CRON_JOBS_SECRET=your_cron_shared_secret_here
LOVABLE_CRON_SECRET=your_managed_cron_secret_here
LOVABLE_CRON_SECRET_PREVIOUS=previous_cron_secret_during_rotation

# --- Auto-apply automation worker ------------------------------------------
AUTO_APPLY_WORKER_URL=https://your-worker-host.example.com
AUTO_APPLY_WORKER_SECRET=your_worker_shared_secret_here
